# =============================================================================
# Distributed Airline Inventory — environment template
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is git-ignored).
# =============================================================================

# ---- API --------------------------------------------------------------------
NODE_ENV=development
NODE_ID=api-local
PORT=3001
SWAGGER_ENABLED=true
LOG_LEVEL=info
# Comma-separated allowed origins, or * for any (development only)
CORS_ORIGINS=*

# ---- Write model: Citus coordinator (strongly consistent) -------------------
# Production (Docker Compose cluster). The API talks to the coordinator (or to
# PgBouncer in front of it) and Citus routes each statement to the right worker.
CITUS_COORDINATOR_URL=postgres://airline:airline@127.0.0.1:55432/airline_inventory
# Optional: transaction-pooling PgBouncer in front of the coordinator.
# When set it is preferred over CITUS_COORDINATOR_URL for application queries.
# PGBOUNCER_URL=postgres://airline:airline@127.0.0.1:6432/airline_inventory
PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# ---- Read model: search / availability projection (eventually consistent) ---
READMODEL_URL=postgres://airline:airline@127.0.0.1:55432/airline_read
# Optional read replica for search. The projector always writes to READMODEL_URL.
# Leave unset to serve search from the primary.
# READMODEL_READ_URL=postgres://airline:airline@127.0.0.1:55433/airline_read
READMODEL_POOL_MAX=20
READMODEL_LAG_SLA_SECONDS=60

# ---- Redis (idempotency, holds, hot cache, rate limits, refresh tokens) -----
# Leave unset to use the built-in in-process driver (development / tests only:
# it is per-process, so it does NOT deduplicate across API instances).
# REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=airline
REDIS_CONNECT_TIMEOUT_MS=2000

# ---- Booking behaviour ------------------------------------------------------
# How long a PENDING hold survives before the reaper releases it.
BOOKING_HOLD_TTL_SECONDS=600
DEFAULT_CABIN=ECONOMY
# requested = accept a specific seat number at booking time (atomic, guarded)
# lazy      = bookings hold counts only; seats assigned later (check-in style)
SEAT_ASSIGNMENT_MODE=requested
# single  = one inventory counter row per (flight, cabin)
# sharded = capacity spread over INVENTORY_SHARD_COUNT rows for hot flights
INVENTORY_STRATEGY=single
INVENTORY_SHARD_COUNT=8

# ---- Payments (simulated gateway, real saga structure) ----------------------
PAYMENT_PROVIDER=SIMULATED
# 0.0 = always succeed. 0.35 = inject failures (exercise compensation paths).
PAYMENT_FAILURE_RATE=0.0
PAYMENT_LATENCY_MS=0
# true  -> POST /api/bookings runs reserve+pay+confirm inline and returns 201
# false -> returns 202 PENDING; a webhook/worker confirms later
BOOKING_SAGA_INLINE=true

# ---- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=distributed-airline-inventory
JWT_AUDIENCE=airline-api
AUTH_RATE_LIMIT_PER_MIN=30
API_RATE_LIMIT_PER_MIN=600
RATE_LIMIT_ENABLED=true
REQUIRE_AUTH_FOR_BOOKING=false
# Two-Factor Authentication (2FA) & Gmail Verification
# true -> Enforce 2FA verification on signin and registration
REQUIRE_2FA=true
# Optional: real Gmail dispatch via Nodemailer (leave empty for simulated dev logger)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# ---- Retry / concurrency ----------------------------------------------------
MAX_RETRIES=4
RETRY_INITIAL_DELAY_MS=15
RETRY_MAX_DELAY_MS=200

# ---- Background workers -----------------------------------------------------
WORKERS_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=200
OUTBOX_MAX_ATTEMPTS=10
REAPER_INTERVAL_MS=30000
REAPER_BATCH_SIZE=200
# Set on a worker-only process so Prometheus can scrape the outbox/read-model gauges.
# Leave 0 (disabled) when workers run in-process with the API, which already serves
# /metrics on PORT.
WORKER_METRICS_PORT=0

# ---- Partition lifecycle ----------------------------------------------------
PARTITION_MONTHS_AHEAD=6
PARTITION_MONTHS_BEHIND=1
PARTITION_RETENTION_MONTHS=24

# ---- Observability ----------------------------------------------------------
METRICS_ENABLED=true
