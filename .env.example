# Application Configuration
NODE_ENV=development
NODE_ID=NODE_A
PORT=3001

# MongoDB Configuration (Must connect to a replica set for MongoDB transactions)
MONGO_URI=mongodb://127.0.0.1:27017/airline_inventory?replicaSet=rs0

# Concurrency & Retry Settings
MAX_RETRIES=3
RETRY_INITIAL_DELAY_MS=15
RETRY_MAX_DELAY_MS=80
