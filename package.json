{
  "name": "distributed-airline-inventory",
  "version": "1.0.0",
  "description": "Distributed Airline Seat Inventory System with Optimistic Concurrency Control and MongoDB Multi-Document Transactions",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "start:node-a": "cross-env NODE_ID=NODE_A PORT=3001 node src/server.js",
    "start:node-b": "cross-env NODE_ID=NODE_B PORT=3002 node src/server.js",
    "start:node-c": "cross-env NODE_ID=NODE_C PORT=3003 node src/server.js",
    "seed": "node scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand",
    "test:concurrency": "jest tests/concurrency --runInBand --detectOpenHandles --forceExit",
    "stress": "node scripts/stress-test.js"
  },
  "keywords": [
    "distributed-systems",
    "concurrency-control",
    "mongodb-transactions",
    "airline-inventory",
    "optimistic-concurrency",
    "idempotency"
  ],
  "author": "Distributed Systems Prototype",
  "license": "ISC",
  "dependencies": {
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.5",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "verbose": true
  }
}
