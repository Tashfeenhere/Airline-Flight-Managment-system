{
  "name": "distributed-airline-inventory",
  "version": "2.0.0",
  "description": "Distributed Airline Seat Inventory System on distributed PostgreSQL (Citus): count-based inventory with anti-oversell, booking saga with simulated payments, CQRS search read model, and a user-sharded my-bookings index.",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:node-a": "cross-env NODE_ID=api-1 PORT=3001 node src/server.js",
    "start:node-b": "cross-env NODE_ID=api-2 PORT=3002 node src/server.js",
    "start:node-c": "cross-env NODE_ID=api-3 PORT=3003 node src/server.js",
    "db:local:start": "node scripts/local-pg-cluster.js start",
    "db:local:stop": "node scripts/local-pg-cluster.js stop",
    "db:local:status": "node scripts/local-pg-cluster.js status",
    "db:setup": "node scripts/db-setup.js",
    "citus:init": "node scripts/citus-init.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/db-status.js",
    "db:reset": "node scripts/db-setup.js --reset",
    "seed:dev": "node scripts/seed-dev-fixture.js",
    "partitions:maintain": "node scripts/partition-maintenance.js",
    "readmodel:reproject": "node scripts/reproject-readmodel.js",
    "backfill": "node scripts/backfill.js",
    "backfill:dry": "node scripts/backfill.js --dry-run",
    "validate:data": "node scripts/validate-data.js",
    "chaos:worker-down": "node scripts/chaos-worker-down.js",
    "load:smoke": "k6 run load/k6/smoke.js",
    "load:search": "k6 run load/k6/search.js",
    "load:booking": "k6 run load/k6/booking.js",
    "reaper:run": "node scripts/run-workers.js reaper",
    "outbox:run": "node scripts/run-workers.js outbox",
    "workers:run": "node scripts/run-workers.js all",
    "audit:oversell": "node scripts/oversell-audit.js",
    "stress": "node scripts/stress-test.js",
    "saga:reconcile": "node scripts/reconcile-sagas.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --detectOpenHandles --forceExit",
    "test:concurrency": "jest tests/concurrency --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "keywords": [
    "distributed-systems",
    "citus",
    "postgresql",
    "concurrency-control",
    "airline-inventory",
    "optimistic-concurrency",
    "saga",
    "idempotency",
    "cqrs"
  ],
  "author": "Distributed Systems Prototype",
  "license": "ISC",
  "dependencies": {
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.2.1",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.0.5"
  },
  "optionalDependencies": {
    "@node-rs/argon2": "^2.0.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 120000,
    "verbose": true,
    "setupFiles": [
      "<rootDir>/tests/helpers/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  }
}
