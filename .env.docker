# Docker Compose Environment Template
# This file is used when running the full stack inside Docker.
NODE_ENV=production
NODE_ID=api-1
PORT=3000
SWAGGER_ENABLED=true
LOG_LEVEL=info
CORS_ORIGINS=*

# In-network database endpoints
CITUS_COORDINATOR_URL=postgres://airline:airline@coordinator:5432/airline_inventory
PGBOUNCER_URL=postgres://airline:airline@pgbouncer:5432/airline_inventory
READMODEL_URL=postgres://airline:airline@readmodel:5432/airline_read
REDIS_URL=redis://redis:6379

PG_POOL_MAX=20
PG_STATEMENT_TIMEOUT_MS=15000
PG_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

BOOKING_HOLD_TTL_SECONDS=600
DEFAULT_CABIN=ECONOMY
SEAT_ASSIGNMENT_MODE=requested
INVENTORY_STRATEGY=single
INVENTORY_SHARD_COUNT=8

PAYMENT_PROVIDER=SIMULATED
PAYMENT_FAILURE_RATE=0.0
PAYMENT_LATENCY_MS=0
BOOKING_SAGA_INLINE=true

JWT_ACCESS_SECRET=docker-production-access-secret-32-chars-long!
JWT_REFRESH_SECRET=docker-production-refresh-secret-32-chars-long!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORDS_ARGON2_MEMORY_KB=65536
PASSWORDS_ARGON2_TIME_COST=3
PASSWORDS_ARGON2_PARALLELISM=1
REQUIRE_AUTH_FOR_BOOKING=false
GUEST_USER_ID=00000000-0000-0000-0000-000000000000
